# Copy to .env and adjust. .env is gitignored; this file is committed.
#
#   cp .env.example .env
#
# Every value here is a local development default. None of them are secrets
# today, and all of them become secrets the moment this runs anywhere real --
# which is the whole reason they live in a file that is not committed.

# ---- Postgres / pgvector ---------------------------------------------------
POSTGRES_USER=sentinel
POSTGRES_PASSWORD=password
POSTGRES_DB=sentinel_db
POSTGRES_PORT=5432

# Consumed by ai-layer/db.py. Must agree with the three values above.
SENTINEL_DATABASE_URL=postgresql+psycopg2://sentinel:password@localhost:5432/sentinel_db

# ---- RabbitMQ --------------------------------------------------------------
RABBITMQ_HOST=localhost
RABBITMQ_PORT=5672
RABBITMQ_MANAGEMENT_PORT=15672
RABBITMQ_USER=guest
RABBITMQ_PASSWORD=guest

# Queue the worker consumes from; the publisher must declare the same name.
SCAN_QUEUE=scan_jobs

# Queue the worker publishes finished scans to, and the gateway consumes.
RESULTS_QUEUE=scan_results

# ---- Redis -----------------------------------------------------------------
REDIS_PORT=6379

# ---- AI triage layer -------------------------------------------------------
TRIAGE_URL=http://localhost:8000/api/v1/triage

# ---- Gateway ---------------------------------------------------------------
# Address the gateway listens on.
GATEWAY_ADDR=:3001

# Consumed by gateway/main.go (scans and findings tables). Same database as
# SENTINEL_DATABASE_URL above, in the URL form the Go driver takes.
DATABASE_URL=postgres://sentinel:password@localhost:5432/sentinel_db

# The shared secret GitHub signs each delivery with (X-Hub-Signature-256).
# Deliberately empty here: the gateway refuses every webhook until this is set,
# rather than accepting unsigned ones. Generate one with: openssl rand -hex 32
GITHUB_WEBHOOK_SECRET=

# Where the gateway fetches the files a push changed. The default is GitHub;
# scripts/e2e_webhook.py points it at a local server instead.
GITHUB_RAW_BASE_URL=https://raw.githubusercontent.com

# Optional. Needed only to scan private repositories.
GITHUB_TOKEN=

# ---- Frontend --------------------------------------------------------------
# Read by the Next.js server, not shipped to the browser.
GATEWAY_URL=http://localhost:3001
